# ============================================================
# FinTrackr — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fintrackr
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=fintrackr
DATABASE_URL=postgresql://fintrackr:change_me_in_production@localhost:5432/fintrackr

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379

# --- JWT ---
JWT_SECRET=change_me_to_random_64_char_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_random_64_char_string
JWT_REFRESH_EXPIRES_IN=30d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=fintrackr
MINIO_USE_SSL=false

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=FinTrackr <noreply@your-domain.com>

# --- Gmail API (for email parsing) ---
GMAIL_CLIENT_ID=your_gmail_api_client_id
GMAIL_CLIENT_SECRET=your_gmail_api_client_secret
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/fintrackr-gmail

# --- GlitchTip (Error Tracking) ---
GLITCHTIP_DSN=http://your-glitchtip-dsn

# --- Encryption ---
ENCRYPTION_KEY=change_me_to_32_char_hex_string_prod

# --- Feature Flags ---
SELF_HOSTED_MODE=true
DISABLE_TIER_LIMITS=true

# --- Caddy (Reverse Proxy) ---
DOMAIN=localhost
CADDY_EMAIL=admin@your-domain.com
