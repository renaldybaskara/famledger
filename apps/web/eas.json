{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://account-subarctic-outrank.ngrok-free.dev/api"
      }
    },
    "production": {
      "channel": "production",
      "android": { "buildType": "app-bundle" },
      "ios": { "buildConfiguration": "Release" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://account-subarctic-outrank.ngrok-free.dev/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
