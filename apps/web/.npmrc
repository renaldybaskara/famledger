; Hoist React Native and Expo packages so Metro can resolve them
; without relying on pnpm's symlink traversal in EAS Build on Linux.
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*@expo/*
public-hoist-pattern[]=*@react-native/*
public-hoist-pattern[]=*@react-navigation/*
public-hoist-pattern[]=babel-preset-expo
public-hoist-pattern[]=nativewind
public-hoist-pattern[]=tailwindcss
