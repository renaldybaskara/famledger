{
  "expo": {
    "name": "Budgetin",
    "slug": "budgetinbudgetin",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/706b486c-4b5d-455d-8b33-8ad48d45b378",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fintrackr",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6B8E6B"
    },
    "ios": {
      "bundleIdentifier": "com.budgetin.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Budgetin butuh akses kamera untuk memfoto slip pembayaran.",
        "NSPhotoLibraryUsageDescription": "Budgetin butuh akses galeri untuk memilih foto slip pembayaran.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.budgetin.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6B8E6B"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "fintrackr"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Budgetin butuh akses galeri untuk memilih foto slip pembayaran.",
          "cameraPermission": "Budgetin butuh akses kamera untuk memfoto slip pembayaran."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "kotlinVersion": "1.9.25"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "706b486c-4b5d-455d-8b33-8ad48d45b378"
      }
    },
    "owner": "renaldybaskaras-organization"
  }
}
