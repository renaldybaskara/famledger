# ============================================================
# Saku — Environment Variables (Scenario 1: Railway DB)
# Copy ke Railway Dashboard → Service → Variables
# ============================================================

# ── Database (Railway PostgreSQL plugin) ─────────────────────
# Di Railway Dashboard gunakan variable reference:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ── Redis (Railway Redis plugin) ─────────────────────────────
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}

# ── JWT Secrets (generate dengan script) ─────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-random-64-char
JWT_REFRESH_SECRET=ganti-dengan-random-64-char-berbeda

# ── App ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
TZ=Asia/Jakarta

# URL frontend Vercel (isi setelah frontend di-deploy)
APP_URL=https://your-app.vercel.app

# ── Self-hosted (disable tier/payment enforcement) ───────────
SELF_HOSTED_MODE=true
DISABLE_TIER_LIMITS=true

# ── Google OAuth (opsional — untuk login Google + Gmail import) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://YOUR_API.railway.app/api/auth/google/callback
GOOGLE_GMAIL_CALLBACK_URL=https://YOUR_API.railway.app/api/email-integrations/gmail/callback

# ── AI Merchant Categorization (opsional) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── SMTP Email (opsional — tanpa ini email di-log ke stdout) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Midtrans Payment Gateway (opsional) ──────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
