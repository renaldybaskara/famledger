# ============================================================
# FinTrackr — Caddyfile
#
# Environment variables (set in docker-compose or .env):
#   DOMAIN          — your domain, e.g. fintrackr.example.com
#                     defaults to "localhost" (no TLS)
#   CADDY_EMAIL     — ACME / Let's Encrypt email (production)
#
# Local development: runs on HTTP port 80 (no TLS)
# Production: change DOMAIN to real domain for auto TLS
# ============================================================

{
    # Let's Encrypt contact email for TLS certificates
    email {$CADDY_EMAIL:admin@localhost}

    # Expose admin / metrics endpoint on internal port
    admin 0.0.0.0:2019
}

# ── Main application — HTTP only for local dev ───────────────
# Listen on all hostnames (works with localhost, LAN IP, or ngrok)
:80 {

    # ── Web frontend (nginx serving Expo static export) ──
    handle / {
        reverse_proxy web:80
    }

    # Catch-all for frontend routes (SPA deep-links)
    handle /* {
        reverse_proxy web:80
    }

    # ── REST API ─────────────────────────────────────────
    handle /api/* {
        reverse_proxy api:4000 {
            # Forward the original scheme from ngrok so the Go API
            # sees X-Forwarded-Proto: https instead of Caddy rewriting it to http
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        }
    }

    # ── Socket.io WebSocket ───────────────────────────────
    handle /socket.io/* {
        reverse_proxy api:4000 {
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        }
    }

    # ── MinIO S3 API ──────────────────────────────────────
    handle /s3/* {
        uri strip_prefix /s3
        reverse_proxy minio:9000
    }

    # ── MinIO web console (admin only) ───────────────────
    handle /minio-console/* {
        uri strip_prefix /minio-console
        reverse_proxy minio:9001
    }

    # ── Compression ───────────────────────────────────────
    encode gzip

    # ── Access logs — stdout ─────────────────────────────
    log {
        output stdout
        format json
    }

    # ── Security headers ──────────────────────────────────
    header {
        -Server
        X-Frame-Options               "SAMEORIGIN"
        X-Content-Type-Options        "nosniff"
        Referrer-Policy               "strict-origin-when-cross-origin"
        ngrok-skip-browser-warning    "true"
    }
}

# ── Grafana ─────────────────────────────────────────────────
http://grafana.{$DOMAIN:localhost} {
    reverse_proxy grafana:3000
    log {
        output stdout
        format json
    }
}

# ── Uptime Kuma ─────────────────────────────────────────────
http://uptime.{$DOMAIN:localhost} {
    reverse_proxy uptime-kuma:3001
    log {
        output stdout
        format json
    }
}

# ── GlitchTip (error tracking) ──────────────────────────────
http://errors.{$DOMAIN:localhost} {
    reverse_proxy glitchtip:8000
    log {
        output stdout
        format json
    }
}

# ── Plausible (analytics) ────────────────────────────────────
http://analytics.{$DOMAIN:localhost} {
    reverse_proxy plausible:8000
    log {
        output stdout
        format json
    }
}
